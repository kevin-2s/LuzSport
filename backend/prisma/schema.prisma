datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Rol {
  SUPERADMIN
  TIENDA
}

enum EstadoVenta {
  PAGADA
  FIADA
}

model Tienda {
  id        String     @id @default(uuid())
  nombre    String
  direccion String
  usuarios  Usuario[]
  articulos Articulo[]
  ventas    Venta[]
  clientes  Cliente[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Usuario {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  rol       Rol
  tiendaId  String?
  tienda    Tienda?  @relation(fields: [tiendaId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Articulo {
  id        String       @id @default(uuid())
  nombre    String
  categoria String
  color     String
  precio    Float
  tiendaId  String
  tienda    Tienda       @relation(fields: [tiendaId], references: [id])
  tallas    TallaStock[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model TallaStock {
  id           String   @id @default(uuid())
  articuloId   String
  articulo     Articulo @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  talla        String
  cantidad     Int
  stockMinimo  Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Venta {
  id        String         @id @default(uuid())
  tiendaId  String
  tienda    Tienda         @relation(fields: [tiendaId], references: [id])
  fecha     DateTime       @default(now())
  total     Float
  estado    EstadoVenta
  detalles  DetalleVenta[]
  fiado     Fiado?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model DetalleVenta {
  id             String @id @default(uuid())
  ventaId        String
  venta          Venta  @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  articuloId     String
  talla          String
  cantidad       Int
  precioUnitario Float
}

model Cliente {
  id        String   @id @default(uuid())
  nombre    String
  telefono  String
  tiendaId  String
  tienda    Tienda   @relation(fields: [tiendaId], references: [id])
  fiados    Fiado[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fiado {
  id             String   @id @default(uuid())
  ventaId        String   @unique
  venta          Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  clienteId      String
  cliente        Cliente  @relation(fields: [clienteId], references: [id])
  saldoPendiente Float
  abonos         Abono[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Abono {
  id        String   @id @default(uuid())
  fiadoId   String
  fiado     Fiado    @relation(fields: [fiadoId], references: [id], onDelete: Cascade)
  fecha     DateTime @default(now())
  monto     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
